# ─────────────────────────────────────────────
# Rooibok HR System — Environment Configuration
# ─────────────────────────────────────────────
# Copy to .env and fill in your values.
# For production: set APP_ENV=production,
# update APP_BASEURL, DB_PASS, ENCRYPTION_KEY.

# ─── Application ────────────────────────────
APP_ENV=development
APP_BASEURL=http://localhost

# ─── PostgreSQL ─────────────────────────────
DB_NAME=rooibok_hr
DB_USER=rooibok_user
DB_PASS=change_this_to_strong_password

# ─── Redis ──────────────────────────────────
REDIS_HOST=redis

# ─── Encryption ─────────────────────────────
# Protects API keys stored in the database.
# Generate with: php spark key:generate
ENCRYPTION_KEY=

# ─── pgAdmin (dev profile only) ─────────────
PGADMIN_EMAIL=admin@rooibok.co.ug
PGADMIN_PASS=change_this

# ─── All other credentials ──────────────────
# Stripe keys      → Super Admin → Settings → Stripe tab
# MTN MoMo keys    → Super Admin → Settings → MTN Mobile Money tab
# Airtel keys      → Super Admin → Settings → Airtel Money tab
# SMS credentials  → Super Admin → Settings → SMS tab
# SMTP credentials → Super Admin → Settings → Email/SMTP tab
# JWT secret       → Super Admin → Settings → API & Security tab
# PAYE tax bands   → Super Admin → Settings → Tax tab
# Geofence radius  → Super Admin → Settings → Attendance tab

# ─── Multi-tenant routing (ADR-003) ─────────
# Platform apex host (no port). Subdomains {slug}.PLATFORM_HOST + admin./api.
# resolve here; anything else is treated as a tenant custom domain.
PLATFORM_HOST=localhost
# Canonical link form emitted by tenant_url(): 'subdomain' (prod) | 'path' (dev).
TENANT_URL_MODE=subdomain
# When 'true', legacy /erp/* GET requests on a tenant host 301 to the clean form.
TENANT_CANONICAL_REDIRECT=false
# Prod (Phase 3): PLATFORM_HOST=rooibok.tech, TENANT_URL_MODE=subdomain,
# TENANT_CANONICAL_REDIRECT=true. Admin host Basic-Auth gate (Traefik middleware),
# value "user:APR1HASH" — generate with `htpasswd -nbB` / `openssl passwd -apr1`.
ADMIN_BASICAUTH_USERS=
